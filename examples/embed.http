# GPUSTACK_EMBED_URL includes /model/proxy/<EMBED_ROUTE_ID>.
# Configure URL and application key in private process environment.
@baseUrl = {{$processEnv GPUSTACK_EMBED_URL}}
@model = nv-community/Nemotron-3-Embed-8B-BF16

### Model identity
GET {{baseUrl}}/v1/models
Authorization: Bearer {{$processEnv GPUSTACK_API_KEY}}

### Query vector
POST {{baseUrl}}/v2/embed
Authorization: Bearer {{$processEnv GPUSTACK_API_KEY}}
Content-Type: application/json

{
  "model": "{{model}}",
  "input_type": "query",
  "texts": ["什么是张量并行？"],
  "embedding_types": ["float"],
  "truncate": "END"
}

### Document vectors for indexing
POST {{baseUrl}}/v2/embed
Authorization: Bearer {{$processEnv GPUSTACK_API_KEY}}
Content-Type: application/json

{
  "model": "{{model}}",
  "input_type": "document",
  "texts": ["张量并行将一次模型计算分配给多张显卡。", "数据并行在多张显卡上运行独立模型副本。"],
  "embedding_types": ["float"],
  "truncate": "END"
}
