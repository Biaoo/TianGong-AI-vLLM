{
  "backend_name": "tiangong-qwen38-custom",
  "description": "Pinned TianGong Qwen3.8 runtime; single-worker TP4+EP with existing runtime fixes",
  "health_check_path": "/health",
  "default_version": "autotune-v1-custom",
  "version_configs": {
    "autotune-v1-custom": {
      "image_name": "tiangong-vllm:qwen38-autotune-v1",
      "custom_framework": "cuda",
      "entrypoint": "/bin/bash /opt/tiangong/serve.sh",
      "run_command": "{{model_path}} --host {{worker_ip}} --port {{port}} --served-model-name {{model_name}} nv-community/Qwen3.8-Flash-Next-NVFP4"
    }
  },
  "default_env": {
    "GPUSTACK_MODEL_RUNTIME_SHM_SIZE_GIB": "16",
    "HF_HUB_OFFLINE": "1",
    "OMP_NUM_THREADS": "8",
    "VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC": "0",
    "SPECULATIVE_CONFIG": "{\"method\":\"mtp\",\"num_speculative_tokens\":3}"
  },
  "default_backend_param": [
    "--tensor-parallel-size=4",
    "--enable-expert-parallel",
    "--enable-flashinfer-autotune",
    "--distributed-executor-backend=mp",
    "--engram-config={\"cpu_offload\":false}",
    "--quantization=modelopt",
    "--gpu-memory-utilization=0.85",
    "--max-model-len=262144",
    "--max-num-seqs=16",
    "--max-num-batched-tokens=8192",
    "--enable-prefix-caching",
    "--reasoning-parser=qwen3",
    "--enable-auto-tool-choice",
    "--tool-call-parser=qwen3_coder",
    "--limit-mm-per-prompt={\"image\":4,\"video\":0}"
  ]
}
