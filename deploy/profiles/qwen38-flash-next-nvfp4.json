{
  "model_id": "nv-community/Qwen3.8-Flash-Next-NVFP4",
  "image": "tiangong-vllm:qwen38-autotune-v1",
  "manifest": "deploy/vllm/model-manifest.json",
  "task": "chat",
  "build": {
    "context": ".",
    "dockerfile": "deploy/vllm/Dockerfile"
  },
  "entrypoint": [
    "/bin/bash",
    "/opt/tiangong/serve.sh"
  ],
  "environment": {
    "VLLM_ALLREDUCE_USE_FLASHINFER_PCIE_IPC": "0"
  },
  "options": {
    "tensor-parallel-size": 4,
    "enable-expert-parallel": true,
    "enable-flashinfer-autotune": true,
    "distributed-executor-backend": "mp",
    "engram-config": {
      "cpu_offload": false
    },
    "quantization": "modelopt",
    "gpu-memory-utilization": 0.85,
    "max-model-len": 262144,
    "max-num-seqs": 16,
    "max-num-batched-tokens": 8192,
    "enable-prefix-caching": true,
    "reasoning-parser": "qwen3",
    "enable-auto-tool-choice": true,
    "tool-call-parser": "qwen3_coder",
    "limit-mm-per-prompt": {
      "image": 4,
      "video": 0
    },
    "speculative-config": {
      "method": "mtp",
      "num_speculative_tokens": 3
    }
  },
  "check_script": "scripts/smoke_test.py"
}
